# FoodieAgent Configuration
PORT=3000

# Optional: Google Gemini API Key for Live Conversational Agent
# If omitted, FoodieAgent runs smoothly in Offline Deterministic Agent Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Gemini Model Selection (defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional: SQLite Database File Path (defaults to ./foodie.db)
# FOODIE_DB_PATH=./foodie.db

# Optional: Automated Database Backup Interval in Minutes (defaults to 15)
BACKUP_INTERVAL_MINUTES=15
